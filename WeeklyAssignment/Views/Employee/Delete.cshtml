@model WeeklyAssignment.ViewModels.Employees.EmployeeDetailsVM

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="mb-4">
    <h1>Delete Employee</h1>
    <p class="text-muted">
        Confirm that you want to remove this employee.
    </p>
</div>

<div class="alert alert-warning">
    Are you sure you want to delete this employee?
    This action cannot be undone.
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <partial name="_EmployeeInformation" model="Model" />

    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Employee.Id" method="post" class="mt-4">

    <button type="submit" class="btn btn-danger">
        Delete Employee
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Cancel
    </a>

</form>