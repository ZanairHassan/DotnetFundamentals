@model WeeklyAssignment.ViewModels.Employees.EmployeeDetailsVM

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="mb-4">
    <h1>Delete Employee</h1>
    <p class="text-muted">
        Confirm that you want to remove this employee.
    </p>
</div>

<div class="alert alert-warning">
    Are you sure you want to delete this employee?
    This action cannot be undone.
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                Name
            </dt>

            <dd class="col-sm-9">
                @Model.Employee.Name
            </dd>

            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.Employee.Email
            </dd>

            <dt class="col-sm-3">
                Salary
            </dt>

            <dd class="col-sm-9">
                @Model.Employee.Salary.ToString("N0")
            </dd>

            <dt class="col-sm-3">
                Joining Date
            </dt>

            <dd class="col-sm-9">
                @Model.Employee.JoiningDate.ToString("dd MMM yyyy")
            </dd>

            <dt class="col-sm-3">
                Designation
            </dt>

            <dd class="col-sm-9">
                @(Model.Designation?.Name ?? "Unknown")
            </dd>

        </dl>

    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Employee.Id" method="post" class="mt-4">

    <button type="submit" class="btn btn-danger">
        Delete Employee
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Cancel
    </a>

</form>