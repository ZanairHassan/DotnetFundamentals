@model WeeklyAssignment.ViewModels.Employees.EmployeeListVM

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Employee Management</h1>
        <p class="text-muted mb-0">
            Manage employees and their designations.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Employee
    </a>
</div>

<form asp-action="Index" method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">

            <div class="col-md-5">
                <label asp-for="SearchTerm" class="form-label">Search</label>

                <input asp-for="SearchTerm" class="form-control" placeholder="Search by name or email..." />
            </div>

            <div class="col-md-4">
                <label asp-for="DesignationId" class="form-label">Designation</label>

                <select asp-for="DesignationId" class="form-select">

                    <option value="">All Designations</option>

                    @foreach (var designation in Model.Designations)
                    {
                        <option value="@designation.Id">
                            @designation.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Clear
                </a>
            </div>

        </div>
    </div>
</form>

@if (!Model.Employees.Any())
{
    <div class="alert alert-info">
        No employees were found.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Salary</th>
                        <th>Joining Date</th>
                        <th>Designation</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var employee in Model.Employees)
                    {
                        var designation = Model.Designations.FirstOrDefault(d => d.Id == employee.DesignationId);

                        <tr>
                            <td>
                                @employee.Name
                            </td>

                            <td>
                                @employee.Email
                            </td>

                            <td>
                                @employee.Salary.ToString("N0")
                            </td>

                            <td>
                                @employee.JoiningDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @(designation?.Name ?? "Unknown")
                            </td>

                            <td class="text-end">
                                <div class="btn-group">

                                    <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
}