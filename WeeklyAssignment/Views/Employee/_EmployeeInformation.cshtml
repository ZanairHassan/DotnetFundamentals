@model WeeklyAssignment.ViewModels.Employees.EmployeeDetailsVM

<dl class="row mb-0">

    <dt class="col-sm-3">
        Name
    </dt>

    <dd class="col-sm-9">
        @Model.Employee.Name
    </dd>

    <dt class="col-sm-3">
        Email
    </dt>

    <dd class="col-sm-9">
        @Model.Employee.Email
    </dd>

    <dt class="col-sm-3">
        Salary
    </dt>

    <dd class="col-sm-9">
        @Model.Employee.Salary.ToString("N0")
    </dd>

    <dt class="col-sm-3">
        Joining Date
    </dt>

    <dd class="col-sm-9">
        @Model.Employee.JoiningDate.ToString("dd MMM yyyy")
    </dd>

    <dt class="col-sm-3">
        Designation
    </dt>

    <dd class="col-sm-9">
        @(Model.Designation?.Name ?? "Unknown")
    </dd>

</dl>