@model MiniAssignment.ViewModels.UserDetailsVM

@{
    ViewData["Title"] = "User Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>User Details</h1>

        <p class="text-muted mb-0">
            View information about this user.
        </p>
    </div>

    <div>
        <a asp-action="Edit"
           asp-route-id="@Model.ID"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Users
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            @Model.FirstName @Model.LastName
        </h5>
    </div>

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                ID
            </dt>

            <dd class="col-sm-9">
                @Model.ID
            </dd>


            <dt class="col-sm-3">
                First Name
            </dt>

            <dd class="col-sm-9">
                @Model.FirstName
            </dd>


            <dt class="col-sm-3">
                Last Name
            </dt>

            <dd class="col-sm-9">
                @Model.LastName
            </dd>


            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.Email
            </dd>


            <dt class="col-sm-3">
                Phone Number
            </dt>

            <dd class="col-sm-9">
                @Model.PhoneNumber
            </dd>


            <dt class="col-sm-3">
                Date of Birth
            </dt>

            <dd class="col-sm-9">
                @Model.DateOfBirth?.ToString("dd MMM yyyy")
            </dd>


            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }
            </dd>


            <dt class="col-sm-3">
                Created At
            </dt>

            <dd class="col-sm-9">
                @Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
            </dd>

        </dl>

    </div>
</div>