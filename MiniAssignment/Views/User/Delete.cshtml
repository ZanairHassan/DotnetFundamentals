@model MiniAssignment.ViewModels.DeleteUserVM

@{
    ViewData["Title"] = "Delete User";
}

<div class="mb-4">
    <h1>Delete User</h1>

    <p class="text-muted">
        Confirm that you want to delete this user.
    </p>
</div>

<div class="alert alert-warning">
    <strong>Warning:</strong>
    This action cannot be undone.
</div>

<div class="card mb-4">
    <div class="card-header">
        User Information
    </div>

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                ID
            </dt>

            <dd class="col-sm-9">
                @Model.ID
            </dd>

            <dt class="col-sm-3">
                Name
            </dt>

            <dd class="col-sm-9">
                @Model.FirstName @Model.LastName
            </dd>

            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.Email
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }
            </dd>

        </dl>

    </div>
</div>

<form asp-controller="User"
      asp-action="Delete"
      asp-route-id="@Model.ID"
      method="post">

    <input asp-for="ID"
           type="hidden" />

    <button type="submit"
            class="btn btn-danger">
        Yes, Delete User
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>