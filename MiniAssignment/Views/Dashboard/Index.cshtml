@model MiniAssignment.ViewModels.DashboardVM

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1>Dashboard</h1>

    <p class="text-muted">
        Overview of the user management system.
    </p>
</div>

<div class="row g-4">

    <div class="col-md-4">

        <a asp-controller="User" asp-action="Index" class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Inactive Users
                    </h6>

                    <h2>
                        @Model.TotalUsers
                    </h2>

                    <small class="text-primary">
                        View All Users →
                    </small>

                </div>

            </div>

        </a>

    </div>

    <div class="col-md-4">

        <a asp-controller="User" asp-action="ActiveUsers" class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Active Users
                    </h6>

                    <h2>
                        @Model.ActiveUsers
                    </h2>

                    <small class="text-primary">
                        View active users →
                    </small>

                </div>

            </div>

        </a>

    </div>

    <div class="col-md-4">

        <a asp-controller="User" asp-action="InactiveUsers" class="text-decoration-none text-dark">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Inactive Users
                    </h6>

                    <h2>
                        @Model.InactiveUsers
                    </h2>

                    <small class="text-primary">
                        View inactive users →
                    </small>

                </div>

            </div>

        </a>

    </div>

</div>

<div class="card mt-4">

    <div class="card-header">
        Quick Actions
    </div>

    <div class="card-body">

        <a asp-controller="User" asp-action="Index" class="btn btn-primary me-2">
            View Users
        </a>

        <a asp-controller="User" asp-action="Create" class="btn btn-success">
            Create User
        </a>

    </div>

</div>