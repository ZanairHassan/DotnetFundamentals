@model IReadOnlyList<RepositoryPattern.Models.Career>

@{
    ViewData["Title"] = "Careers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Careers</h1>
        <p class="text-muted">
            Manage available career positions.
        </p>
    </div>

    <a asp-controller="Career" asp-action="Create" class="btn btn-primary">
        Create Career
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No careers are available.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var career in Model)
            {
                <tr>
                    <td>@career.Title</td>

                    <td>@career.Description</td>

                    <td>
                        <a asp-controller="Career" asp-action="Details" asp-route-id="@career.Id" class="btn btn-sm btn-info">
                            Details
                        </a>

                        <a asp-controller="Career" asp-action="Edit" asp-route-id="@career.Id" class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-controller="Career" asp-action="Delete" asp-route-id="@career.Id" class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}