@model RepositoryPattern.Models.Career

@{
    ViewData["Title"] = "Career Details";
}

<h1>Career Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Title
    </dt>

    <dd class="col-sm-9">
        @Model.Title
    </dd>

    <dt class="col-sm-3">
        Description
    </dt>

    <dd class="col-sm-9">
        @Model.Description
    </dd>

</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
    Edit
</a>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>