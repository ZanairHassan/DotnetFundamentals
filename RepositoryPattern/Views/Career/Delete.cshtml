@model RepositoryPattern.Models.Career

@{
    ViewData["Title"] = "Delete Career";
}

<h1>Delete Career</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this career?
</div>

<dl class="row">

    <dt class="col-sm-3">
        Title
    </dt>

    <dd class="col-sm-9">
        @Model.Title
    </dd>

    <dt class="col-sm-3">
        Description
    </dt>

    <dd class="col-sm-9">
        @Model.Description
    </dd>

</dl>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>