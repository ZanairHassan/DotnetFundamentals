@model RepositoryPattern.ViewModels.UserListVM

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>User Management</h1>
        <p class="text-muted mb-0">
            Manage users in the application.
        </p>
    </div>

    <a href="/users/create" class="btn btn-primary">
        Create User
    </a>
</div>

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="mb-1">Assign Career</h5>
                <p class="text-muted mb-0">
                    Select one or more users and assign them a career.
                </p>
            </div>
        </div>

        <form method="post" action="/users/assigncareer">

            @Html.AntiForgeryToken()

            <div class="row g-2 align-items-end">

                <div class="col-md-8">
                    <label for="CareerId" class="form-label">Career</label>

                    <select name="CareerId" id="CareerId" class="form-select">

                        <option value="">Select Career</option>
                        
                        @foreach (var career in Model.Careers)
                        {
                            <option value="@career.Id">@career.Title</option>
                        }
                    </select>
                </div>

                <div class="col-md-4 d-grid">
                    <button type="submit" class="btn btn-primary">
                        Assign Career
                    </button>
                </div>
            </div>

            <div class="mt-3">
                <small class="text-muted">
                    Select users from the table below before assigning a career.
                </small>
            </div>

            <div class="mt-2">
                <span id="selectedUserCount" class="badge bg-secondary">
                    0 users selected
                </span>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>
                                    <input type="checkbox" id="selectAllUsers" class="form-check-input" />
                                </th>

                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Date of Birth</th>
                                <th>Career</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (!Model.Users.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        No users found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var user in Model.Users)
                                {
                                    <tr>

                                        <td>
                                            <input type="checkbox" name="SelectedUserIds" value="@user.Id" class="form-check-input user-checkbox" />
                                        </td>

                                        <td>@user.Id</td>

                                        <td>
                                            @user.FirstName @user.LastName
                                        </td>

                                        <td>
                                            @user.Email
                                        </td>

                                        <td>
                                            @user.PhoneNumber
                                        </td>

                                        <td>
                                            @user.DateOfBirth.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            @{
                                                var career = Model.Careers .FirstOrDefault(c => c.Id == user.CareerId);
                                            }

                                            @if (career is not null)
                                            {
                                                <a href="/careers/@career.Id" class="badge bg-info text-dark"> @career.Title</a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">Not Assigned</span>
                                            }
                                        </td>

                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <div class="btn-group" role="group">
                                                <a href="/users/@user.Id" class="btn btn-sm btn-info">Details</a>

                                                <a href="/users/edit/@user.Id" class="btn btn-sm btn-warning">Edit</a>

                                                <a href="/users/delete/@user.Id" class="btn btn-sm btn-danger">Delete</a>
                                            </div>

                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>

    </div>

    @section Scripts
    {
        <script>
                  const selectAllCheckbox = document.getElementById("selectAllUsers");

                      const userCheckboxes = document.querySelectorAll(".user-checkbox");

                      const selectedUserCount = document.getElementById("selectedUserCount");

                      function updateSelectedUserCount() {

                          const selectedCount =document.querySelectorAll(".user-checkbox:checked").length;

                          selectedUserCount.textContent =`${ selectedCount } user${ selectedCount === 1 ? "" : "s" } selected`;
                      }

                      selectAllCheckbox.addEventListener("change",
                          function () {
                              userCheckboxes.forEach(
                                  checkbox => { checkbox.checked = selectAllCheckbox.checked; }
                              );

                              updateSelectedUserCount();
                          }
                      );

                      userCheckboxes.forEach(
                          checkbox => {

                              checkbox.addEventListener("change",
                                  function () {

                                      const allSelected = document.querySelectorAll(".user-checkbox")
                                      .length === document.querySelectorAll(".user-checkbox:checked").length;

                                      selectAllCheckbox.checked = allSelected;

                                      updateSelectedUserCount();
                                  }
                              );

                          }
                      );

                      updateSelectedUserCount();
        </script>        
    }