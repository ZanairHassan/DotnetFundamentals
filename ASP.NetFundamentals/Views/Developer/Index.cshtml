@model IEnumerable<ASP.NetFundamentals.Models.Developer>

@{
    ViewData["Title"] = "Developers";
}

<h1>Developers</h1>


<div class="mb-3">
    <a asp-action="Create"
       class="btn btn-primary">
        Create Developer
    </a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            alert("@TempData["SuccessMessage"]");
        });
    </script>
}

@if (TempData["ErrorMessage"] is not null)
{
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            alert("@TempData["ErrorMessage"]");
        });
    </script>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Field</th>
            <th>Age</th>
            <th>Role</th>
            <th>Experience</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var developer in Model)
        {
            <tr>
                <td>@developer.Name</td>
                <td>@developer.Email</td>
                <td>@developer.Field</td>
                <td>@developer.Age</td>
                <td>@developer.Role</td>
                <td>@developer.Experience</td>
                <td>@developer.Salary</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@developer.ID"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@developer.ID"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@developer.ID"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>