@model ASP.NetFundamentals.Models.Developer

@{
    ViewData["Title"] = "Delete Developer";
}

<h1>Delete Developer</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this employee?
</div>
<div>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Field</dt>
        <dd class="col-sm-9">@Model.Field</dd>

        <dt class="col-sm-3">Age</dt>
        <dd class="col-sm-9">@Model.Age</dd>

        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@Model.Role</dd>

        <dt class="col-sm-3">Experience</dt>
        <dd class="col-sm-9">@Model.Experience years</dd>

        <dt class="col-sm-3">Salary</dt>
        <dd class="col-sm-9">@Model.Salary</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" asp-for="ID" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>