<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Testing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASP.NetFundamentals.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["PageClass"]">
    
    <header>
        <h1 class="text-bg-secondary text-md-center">CM IT Internship</h1>
    </header>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3 text-bg-success">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="PracticeView" asp-action="RenderIndex">Dotnet Fundamentals Practice</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Student" asp-action="Index">Student</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Employee" asp-action="Index">Employees</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Developer" asp-action="Index">Developers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Dependency" asp-action="Index">Dependencies</a>
                        </li>
                       
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            <p class="text-bg-secondary text-md-center">MVC Fundamentals Practice Project</p>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)

</body>