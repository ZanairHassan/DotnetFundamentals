@model object

<dl class="row">
    @foreach (var property in Model.GetType().GetProperties())
    {
        if (property.Name.Equals("ID", StringComparison.OrdinalIgnoreCase))
        {
            continue;
        }

        <dt class="col-sm-3">
            @property.Name
        </dt>

        <dd class="col-sm-9">
            @property.GetValue(Model)
        </dd>
    }
</dl>