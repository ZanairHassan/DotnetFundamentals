@model ASP.NetFundamentals.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h1>Delete Employee</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this employee?
</div>

<dl class="row">

    <dt class="col-sm-3">
        Name
    </dt>

    <dd class="col-sm-9">
        @Model.Name
    </dd>

    <dt class="col-sm-3">
        Email
    </dt>

    <dd class="col-sm-9">
        @Model.Email
    </dd>

    <dt class="col-sm-3">
        Department
    </dt>

    <dd class="col-sm-9">
        @Model.Department
    </dd>

    <dt class="col-sm-3">
        Designation
    </dt>

    <dd class="col-sm-9">
        @Model.Designation
    </dd>

</dl>

<form asp-action="DeleteConfirmed"
      method="post">

    <input type="hidden"
           asp-for="ID" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>