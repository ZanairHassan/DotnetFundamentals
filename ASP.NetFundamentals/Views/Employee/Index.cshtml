@model IEnumerable<ASP.NetFundamentals.Models.Employee>

@{
    ViewData["Title"] = "Employees";
    ViewData["PageClass"] = "employeeDetails";
}

<h1>Employees</h1>

<div class="mb-3">
    <a asp-action="Create"
       class="btn btn-primary">
        Create Employee
    </a>
</div>

<form asp-action="Index"
      method="get"
      class="mb-4">

    <div class="input-group">

        <input type="text"
               name="searchTerm"
               value="@ViewBag.SearchTerm"
               class="form-control"
               placeholder="Search by ID or Name..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Clear
        </a>

    </div>

</form>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Age</th>
            <th>Salary</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Available</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (!Model.Any())
        {
            <tr>
                <td colspan="9"
                    class="text-center">
                    No employees found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.ID</td>
                    <td>@employee.Name</td>
                    <td>@employee.Email</td>
                    <td>@employee.Age</td>
                    <td>@employee.Salary</td>
                    <td>@employee.Department</td>
                    <td>@employee.Designation</td>
                    <td>@employee.IsAvailable</td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@employee.ID"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@employee.ID"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@employee.ID"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        }

    </tbody>

</table>